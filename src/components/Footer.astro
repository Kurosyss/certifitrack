---
import { siteConfig } from '../config/site';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const footerLinks = [
  {
    title: t('footer.product'),
    links: [
      { name: t('nav.whatWeDo'), href: translatePath('/what-we-do') },
      { name: t('nav.howItWorks'), href: translatePath('/how-it-works') },
      { name: t('nav.template'), href: translatePath('/templates/coi-tracking-spreadsheet') },
    ],
  },
  {
    title: t('footer.support'),
    links: [
      { name: t('nav.faq'), href: translatePath('/faq'), external: false },
      { name: t('footer.contact'), href: translatePath('/contact'), external: false },
      { name: t('footer.buyCoffee'), href: siteConfig.buyMeACoffee, external: true },
      { name: t('footer.github'), href: siteConfig.socials.github, external: true },
    ],
  },
  {
    title: t('footer.legal'),
    links: [
      { name: t('footer.privacy'), href: translatePath('/privacy'), external: false },
      { name: t('footer.terms'), href: translatePath('/terms'), external: false },
    ],
  },
];
---

<footer class="border-t border-border bg-muted/20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl spacing-footer">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="space-y-4 md:col-span-1">
        <span class="font-bold text-xl tracking-tight text-primary">{siteConfig.name}</span>
        <p class="text-small text-muted-foreground leading-relaxed">
          {t('footer.description')}
        </p>
      </div>
      
      {footerLinks.map((section) => (
        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-foreground tracking-wider">{section.title}</h3>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li>
                <a 
                  href={link.href} 
                  class="text-sm text-muted-foreground hover:text-primary transition-colors"
                  {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    
    <div class="spacing-cta">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 mb-8 text-xs font-medium text-muted-foreground uppercase tracking-wider">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-foreground/60"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
          Open Source
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-foreground/60"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          Local First
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-foreground/60"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          Bring Your Own API
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-foreground/60"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Secure Extraction
        </div>
      </div>

      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-muted-foreground text-center md:text-left">
        <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
        <p class="max-w-xl text-right">{t('footer.disclaimer')}</p>
      </div>
    </div>
  </div>
</footer>
