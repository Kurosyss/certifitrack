---
import { siteConfig } from '../config/site';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const footerSections = [
  {
    title: t('footer.product'),
    links: [
      { name: t('nav.whatWeDo'), href: translatePath('/what-we-do') },
      { name: t('nav.howItWorks'), href: translatePath('/how-it-works') },
      { name: t('nav.template'), href: translatePath('/templates/coi-tracking-spreadsheet') },
    ],
  },
  {
    title: t('footer.resources'),
    links: [
      { name: t('nav.about'), href: translatePath('/about') },
      { name: t('nav.faq'), href: translatePath('/faq') },
      { name: t('nav.contact'), href: translatePath('/contact') },
    ],
  },
  {
    title: t('footer.legal'),
    links: [
      { name: t('footer.privacy'), href: translatePath('/privacy') },
      { name: t('footer.terms'), href: translatePath('/terms') },
    ],
  },
  {
    title: t('footer.support'),
    links: [
      { name: t('footer.buyCoffee'), href: siteConfig.buyMeACoffee, external: true },
      { name: t('footer.github'), href: siteConfig.socials.github, external: true },
    ],
  },
];
---

<footer class="border-t border-border bg-muted/20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl spacing-footer">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">
      <div class="col-span-2 md:col-span-1 space-y-3">
        <a href={translatePath('/')} class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 100 100">
            <path d="M 45 15 A 35 35 0 0 0 45 85 Z" fill="currentColor"/>
            <rect x="65" y="15" width="15" height="70" fill="currentColor"/>
          </svg>
          <span class="font-bold text-lg tracking-tight text-primary">{siteConfig.name}</span>
        </a>
        <p class="text-small text-muted-foreground leading-relaxed pr-2">
          {t('footer.description')}
        </p>
      </div>
      
      {footerSections.map((section) => (
        <div class="space-y-3">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-foreground">{section.title}</h3>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a 
                  href={link.href} 
                  class="text-small text-muted-foreground hover:text-foreground transition-colors"
                  {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    
    <div class="pt-8 border-t border-border/60 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-muted-foreground text-center md:text-left">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
      <p class="max-w-xl text-right text-[11px] leading-relaxed opacity-80">{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>
