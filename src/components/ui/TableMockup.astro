---
import StatusChip from './StatusChip.astro';
import { Search, Filter, MoreHorizontal, FileText, ChevronDown } from 'lucide-react';

const mockData = [
  { name: "ABC Framing", trade: "Framing", expire: "09/15/2026", status: "active" as const },
  { name: "Smith Plumbing", trade: "Plumbing", expire: "01/12/2026", status: "expired" as const },
  { name: "Titan Concrete", trade: "Concrete", expire: "08/30/2026", status: "review" as const },
  { name: "Elite Roofing", trade: "Roofing", expire: "--/--/----", status: "missing" as const },
];
---

<div class="w-full bg-surface border border-border rounded-xl shadow-elevated overflow-hidden flex flex-col font-sans text-sm">
  {/* Mock Toolbar */}
  <div class="px-4 py-3 border-b border-border flex items-center justify-between bg-surface/50">
    <div class="flex items-center gap-2 text-muted-foreground bg-muted px-3 py-1.5 rounded-md border border-border text-xs w-48">
      <Search className="w-3 h-3" />
      <span>Search subcontractors...</span>
    </div>
    <div class="flex items-center gap-2">
      <button class="flex items-center gap-1.5 text-xs font-medium text-foreground bg-surface border border-border px-2 py-1.5 rounded hover:bg-surface-hover transition-colors">
        <Filter className="w-3 h-3" />
        Filter <ChevronDown className="w-3 h-3 opacity-50" />
      </button>
    </div>
  </div>

  {/* Mock Table Header */}
  <div class="grid grid-cols-12 gap-4 px-4 py-2 border-b border-border bg-muted/30 text-xs font-medium text-muted-foreground uppercase tracking-wider">
    <div class="col-span-4 sm:col-span-5">Subcontractor</div>
    <div class="hidden sm:block sm:col-span-3">Trade</div>
    <div class="col-span-4 sm:col-span-2">Status</div>
    <div class="col-span-4 sm:col-span-2 text-right">Expiration</div>
  </div>

  {/* Mock Table Body */}
  <div class="flex flex-col divide-y divide-border">
    {mockData.map((row) => (
      <div class="grid grid-cols-12 gap-4 px-4 py-3 items-center hover:bg-surface-hover transition-colors cursor-default group">
        <div class="col-span-4 sm:col-span-5 flex items-center gap-3">
          <div class="w-7 h-7 rounded bg-muted flex items-center justify-center border border-border shrink-0 group-hover:bg-accent/10 group-hover:text-accent group-hover:border-accent/20 transition-colors">
            <FileText className="w-3.5 h-3.5 text-muted-foreground group-hover:text-accent transition-colors" />
          </div>
          <span class="font-medium text-foreground truncate">{row.name}</span>
        </div>
        <div class="hidden sm:flex sm:col-span-3 items-center text-muted-foreground">
          {row.trade}
        </div>
        <div class="col-span-4 sm:col-span-2 flex items-center">
          <StatusChip status={row.status} />
        </div>
        <div class="col-span-4 sm:col-span-2 flex items-center justify-end text-muted-foreground font-mono text-xs">
          {row.expire}
        </div>
      </div>
    ))}
  </div>
</div>
