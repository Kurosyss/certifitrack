---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// Use English as default for now, since that's where we are starting
const currentLang = Astro.currentLocale || 'en';
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
	</head>
	<body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary selection:text-primary-foreground">
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
