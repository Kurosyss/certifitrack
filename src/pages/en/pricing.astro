---
import { siteConfig } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import CheckoutButton from '../../components/CheckoutButton.tsx';
import { ArrowRight, CheckCircle2, FileSpreadsheet, Lock } from 'lucide-react';

const title = "Pricing | CertifiTrack Cleanup";
const description = "Simple pricing. One-time cleanup. No subscriptions or software setup.";
---

<Layout title={title} description={description}>
  <section class="spacing-section border-b border-border bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-h1 text-foreground spacing-heading text-balance">Simple pricing. One-time cleanup.</h1>
        <p class="text-body-large spacing-paragraph">No monthly subscription. No software setup. No portal for your team. You send the files. We organize them.</p>
      </div>
      
      {/* $49 Tier - HERO PRIMARY */}
      <div class="bg-surface rounded-3xl border border-border shadow-elevated overflow-hidden mb-12">
        <div class="p-8 sm:p-12">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 mb-12 border-b border-border/50 pb-12">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1 text-[11px] font-medium tracking-wide uppercase text-muted-foreground mb-4">
                <span class="flex h-1.5 w-1.5 rounded-full bg-status-active"></span>
                Standard Service
              </div>
              <h2 class="text-display text-foreground">Clean Up My COI Folder</h2>
              <p class="text-body text-muted-foreground mt-2">Up to 25 subcontractors.</p>
            </div>
            
            <div class="flex flex-col md:items-end">
              <div class="flex items-baseline gap-2">
                <span class="text-5xl lg:text-6xl font-medium tracking-tight text-foreground">$49</span>
                <span class="text-sm font-medium uppercase tracking-widest text-muted-foreground">one-time</span>
              </div>
              <p class="text-xs text-muted-foreground mt-2 flex items-center gap-1.5"><Lock class="w-3.5 h-3.5"/> Secure Stripe Checkout</p>
            </div>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8 mb-12">
            <div class="flex flex-col gap-2">
              <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">What you send</span>
              <p class="text-sm font-medium text-foreground">An unorganized ZIP folder of your COI PDFs and your subcontractor list.</p>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">What we return</span>
              <p class="text-sm font-medium text-foreground">A structured Excel tracker highlighting missing and expired records.</p>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">Delivery</span>
              <p class="text-sm font-medium text-foreground">Completed and delivered to your inbox within 24–48 hours.</p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 items-center justify-between bg-background p-6 rounded-2xl border border-border">
            <div class="flex items-center gap-3">
              <FileSpreadsheet class="w-8 h-8 text-status-active"/>
              <div>
                <div class="text-sm font-medium text-foreground">Ready to start?</div>
                <div class="text-xs text-muted-foreground">Upload your files on the next screen.</div>
              </div>
            </div>
            <CheckoutButton 
              client:load
              text="Start Cleanup Process — $49"
              className="w-full sm:w-auto shadow-elevated transition-transform hover:scale-105"
            />
          </div>
        </div>
      </div>

      {/* $99 Tier & Custom - SECONDARY (Side by side at bottom) */}
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-background rounded-2xl border border-border p-8 text-center flex flex-col justify-center">
          <h3 class="text-h3 text-foreground mb-1">More than 25 subcontractors?</h3>
          <p class="text-small mb-6">Our Pro tier handles up to 100 subcontractors for a flat $99 fee. Same 24-hour delivery.</p>
          <div class="mt-auto">
            <Button href={siteConfig.stripePaymentLink100} variant="outline" class="w-full bg-surface">
              Select Pro Tier &mdash; $99
            </Button>
          </div>
        </div>

        <div class="bg-background rounded-2xl border border-border p-8 text-center flex flex-col justify-center">
          <h3 class="text-h3 text-foreground mb-1">Need enterprise compliance?</h3>
          <p class="text-small mb-6">Over 100+ subcontractors or need ongoing COI monitoring throughout the year?</p>
          <div class="mt-auto">
            <Button href="/en/contact" variant="outline" class="w-full bg-surface">
              Contact Sales
            </Button>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
