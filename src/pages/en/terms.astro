---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';

const title = "Terms of Service | CertifiTrack";
const description = "Terms and conditions for using CertifiTrack.";
---

<Layout title={title} description={description}>
  <section class="py-16 sm:py-24 bg-background">
    <div class="reading-width px-4 sm:px-6">
      
      {/* Header */}
      <div class="mb-12">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground mb-3">Terms of Service</h1>
        <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest">Last Updated: August 2026</p>
      </div>

      {/* Intro */}
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <p class="text-base leading-relaxed text-muted-foreground mb-10">
          By using {siteConfig.legalEntityName} ("CertifiTrack"), you agree to these Terms. Please read them carefully.
        </p>

        {/* Contents Navigation */}
        <div class="bg-surface border border-border rounded-lg p-5 mb-12 shadow-subtle">
          <h2 class="text-xs font-semibold text-foreground uppercase tracking-widest mb-3">Contents</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#service" class="text-muted-foreground hover:text-foreground transition-colors">1. Description of Service</a></li>
            <li><a href="#limitations" class="text-muted-foreground hover:text-foreground transition-colors">2. Limitations of Liability</a></li>
            <li><a href="#intellectual-property" class="text-muted-foreground hover:text-foreground transition-colors">3. Intellectual Property</a></li>
            <li><a href="#governing-law" class="text-muted-foreground hover:text-foreground transition-colors">4. Governing Law</a></li>
            <li><a href="#contact" class="text-muted-foreground hover:text-foreground transition-colors">5. Contact Us</a></li>
          </ul>
        </div>

        {/* Content Sections */}
        <div class="space-y-12">
          
          <section id="service" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">1. Description of Service</h2>
            <p class="text-base text-muted-foreground mb-4">
              CertifiTrack provides administrative data extraction services for Certificates of Insurance (COIs). We receive your documents, organize them, extract data into a spreadsheet, and return the results.
            </p>
            <p class="text-base text-muted-foreground font-medium text-foreground">
              CertifiTrack is NOT an insurance broker, agent, or compliance software. We do not make coverage determinations or guarantee that your subcontractors are properly insured.
            </p>
          </section>

          <section id="limitations" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">2. Limitations of Liability</h2>
            <p class="text-base text-muted-foreground mb-4">
              While we strive for accuracy in data extraction, optical character recognition (OCR) and manual review can produce errors. You are solely responsible for verifying the accuracy of the returned data before making any business decisions based upon it.
            </p>
            <p class="text-base text-muted-foreground">
              To the maximum extent permitted by law, CertifiTrack shall not be liable for any indirect, incidental, special, consequential, or punitive damages resulting from your use of the service.
            </p>
          </section>

          <section id="intellectual-property" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">3. Intellectual Property</h2>
            <p class="text-base text-muted-foreground">
              You retain all rights to the documents you upload. By uploading them, you grant us a limited license to process them solely for the purpose of providing the service to you.
            </p>
          </section>

          <section id="governing-law" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">4. Governing Law</h2>
            <p class="text-base text-muted-foreground">
              These Terms shall be governed by and construed in accordance with the laws of {siteConfig.governingLaw}, without regard to its conflict of law provisions.
            </p>
          </section>

          <section id="contact" class="scroll-mt-24 pt-8 border-t border-border">
            <h2 class="text-xl font-semibold text-foreground mb-3">5. Contact Us</h2>
            <p class="text-base text-muted-foreground mb-4">
              If you have questions about these Terms, please contact our support team.
            </p>
            <a href={`mailto:${siteConfig.supportEmail}`} class="text-accent hover:underline font-medium">{siteConfig.supportEmail}</a>
          </section>

        </div>
      </div>

    </div>
  </section>
</Layout>
