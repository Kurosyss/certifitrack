---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { UploadCloud, CheckCircle2, FileSpreadsheet, Cpu, ArrowRight } from 'lucide-react';

const title = "How It Works | CertifiTrack";
const description = "Learn how CertifiTrack extracts and validates ACORD 25 Certificates of Insurance into structured Excel workbooks.";
---

<Layout title={title} description={description}>
  <section class="spacing-section border-b border-border bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-caption text-muted-foreground mb-4 shadow-subtle">
          Three-Step Workflow
        </div>
        <h1 class="text-h1 text-foreground spacing-heading text-balance">How CertifiTrack Works</h1>
        <p class="text-body-large text-muted-foreground text-pretty">
          From unorganized PDF folders to structured, audit-ready insurance records in seconds.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 relative max-w-5xl mx-auto">
        {/* Step 1 */}
        <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface p-6 shadow-subtle relative">
          <div class="w-8 h-8 rounded-full bg-background border border-border flex items-center justify-center text-foreground font-semibold text-xs shrink-0 shadow-subtle">
            01
          </div>
          <div>
            <h2 class="text-h3 text-foreground mb-2">Upload Documents</h2>
            <p class="text-small text-muted-foreground leading-relaxed">
              Drag and drop individual ACORD 25 PDF certificates or a batch .ZIP archive containing multiple documents.
            </p>
          </div>
          <div class="border border-dashed border-border bg-background rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 mt-auto">
            <UploadCloud class="w-5 h-5 text-muted-foreground" />
            <span class="text-[11px] font-sans tabular-nums text-muted-foreground">.pdf or .zip up to 10MB</span>
          </div>
        </div>
        
        {/* Step 2 */}
        <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface p-6 shadow-subtle relative">
          <div class="w-8 h-8 rounded-full bg-background border border-border flex items-center justify-center text-foreground font-semibold text-xs shrink-0 shadow-subtle">
            02
          </div>
          <div>
            <h2 class="text-h3 text-foreground mb-2">Extract & Normalize</h2>
            <p class="text-small text-muted-foreground leading-relaxed">
              The engine isolates coverage tables, standardizes policy numbers, normalizes expiration dates, and structures limits.
            </p>
          </div>
          <div class="bg-background rounded-xl border border-border p-4 mt-auto space-y-2.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">General Liability</span>
              <span class="tabular-nums font-medium text-foreground">$1,000,000 / $2,000,000</span>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">Workers' Comp</span>
              <span class="font-medium text-foreground">Statutory</span>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">Consistent Dates</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-medium tabular-nums">2026-01-15 &rarr; 2027-01-15</span>
            </div>
          </div>
        </div>
        
        {/* Step 3 */}
        <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface p-6 shadow-subtle relative">
          <div class="w-8 h-8 rounded-full bg-background border border-border flex items-center justify-center text-foreground font-semibold text-xs shrink-0 shadow-subtle">
            03
          </div>
          <div>
            <h2 class="text-h3 text-foreground mb-2">Download Your Workbook</h2>
            <p class="text-small text-muted-foreground leading-relaxed">
              Instantly receive a structured Excel (.xlsx) workbook highlighting active, expiring, and missing policy records.
            </p>
          </div>
          <div class="bg-background rounded-xl border border-border p-4 mt-auto flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-semibold text-foreground">
              <FileSpreadsheet class="w-4 h-4 text-status-active" />
              <span>COI_Tracker_Export.xlsx</span>
            </div>
            <CheckCircle2 class="w-4 h-4 text-status-active" />
          </div>
        </div>
      </div>
      
    </div>
  </section>

  {/* CTA */}
  <section class="spacing-section bg-surface text-center">
    <div class="container mx-auto px-4 max-w-xl">
      <h2 class="text-h2 text-foreground spacing-heading">Ready to process your certificates?</h2>
      <p class="text-body-large spacing-paragraph">Upload your files to generate an audit-ready insurance tracker.</p>
      <Button href="/en/upload" size="lg" class="shadow-elevated transition-transform hover:scale-105">
        Start Extracting Free
      </Button>
    </div>
  </section>
</Layout>
