---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { 
  FileText, 
  ShieldCheck, 
  Car, 
  Layers, 
  CheckCircle2, 
  Building2,
  Calendar,
  DollarSign,
  FileCheck,
  ArrowRight
} from 'lucide-react';

const title = "Supported Insurance Fields & Schema | CertifiTrack";
const description = "Learn which ACORD 25 insurance fields CertifiTrack extracts: policy numbers, expiration dates, coverage limits, and compliance endorsements.";

const categories = [
  {
    title: "Certificate & Party Information",
    description: "Core certificate metadata identifying the parties listed on the document and the source file reference.",
    icon: Building2,
    fields: [
      { name: "Named Insured", desc: "The person or organization listed as insured on the certificate." },
      { name: "Producer / Broker", desc: "The issuing insurance agency or broker contact managing the certificate." },
      { name: "Certificate Holder", desc: "The designated certificate recipient organization or project authority." },
      { name: "Insurer / Carrier", desc: "Underwriting carrier names and NAIC / letter designations listed for each line of coverage." },
      { name: "Source Document", desc: "Original filename preserved on every row for fast verification and audit checks." }
    ]
  },
  {
    title: "General Liability (CGL)",
    description: "Commercial General Liability policy references, term dates, and coverage limits extracted from the certificate.",
    icon: ShieldCheck,
    fields: [
      { name: "Policy Number", desc: "Commercial general liability policy reference number." },
      { name: "Effective & Expiration Dates", desc: "Policy term dates extracted and normalized into structured date values." },
      { name: "Each Occurrence Limit", desc: "Per-occurrence coverage limit extracted from the General Liability section." },
      { name: "General Aggregate Limit", desc: "General aggregate limit extracted from the General Liability section." },
      { name: "Products & Completed Operations", desc: "Products and completed operations aggregate limit extracted from the certificate." }
    ]
  },
  {
    title: "Workers' Compensation & Employer's Liability",
    description: "Workers' Compensation policy references, statutory indicators, and employer's liability limits.",
    icon: FileText,
    fields: [
      { name: "Policy Number & Term Dates", desc: "Workers' Compensation policy number, effective date, and expiration date." },
      { name: "Statutory Limits Indicator", desc: "Extracted checkbox flag indicating statutory workers' compensation coverage." },
      { name: "Employer's Liability Limits", desc: "Extracted limits for each accident, disease policy limit, and disease each employee." }
    ]
  },
  {
    title: "Commercial Automobile Liability",
    description: "Policy number, coverage period, combined single limit, and supported vehicle-scope information extracted from the certificate.",
    icon: Car,
    fields: [
      { name: "Policy Number & Term Dates", desc: "Automobile liability policy number, effective date, and expiration date." },
      { name: "Combined Single Limit (CSL)", desc: "Combined single limit (or split bodily injury / property damage limits) extracted from the auto section." },
      { name: "Vehicle Scope Flags", desc: "Extracted indicator flags for Any Auto, All Owned Autos, Scheduled, or Hired/Non-Owned vehicles." }
    ]
  },
  {
    title: "Umbrella & Excess Liability",
    description: "Excess or Umbrella liability policy numbers, term dates, occurrence limits, and aggregate limits.",
    icon: Layers,
    fields: [
      { name: "Policy Number & Term Dates", desc: "Commercial Umbrella or Excess liability policy identifier and coverage dates." },
      { name: "Each Occurrence & Aggregate Limits", desc: "Each occurrence limit and aggregate limit extracted from the umbrella section." }
    ]
  },
  {
    title: "Endorsement Flags & Tracking Status",
    description: "Contractual endorsement indicators and evaluated date status based on extracted term dates.",
    icon: FileCheck,
    fields: [
      { name: "Additional Insured Status", desc: "Extracted checkbox indicator confirming Additional Insured endorsement." },
      { name: "Waiver of Subrogation", desc: "Extracted checkbox indicator confirming Waiver of Subrogation endorsement." },
      { name: "Tracking Status", desc: "Calculated date status based on extracted expiration dates: CURRENT, EXPIRING, EXPIRED, or REVIEW." }
    ]
  }
];
---

<Layout title={title} description={description}>
  {/* Page Header */}
  <section class="spacing-section bg-background border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-caption text-muted-foreground mb-4 shadow-subtle">
          Supported Fields & Schema
        </div>
        <h1 class="text-h1 text-foreground spacing-heading text-balance font-semibold">
          What Insurance Fields Does CertifiTrack Extract?
        </h1>
        <p class="text-body-large spacing-paragraph text-muted-foreground text-pretty">
          CertifiTrack systematically parses standard ACORD 25 certificates to normalize contractor identities, policy timelines, coverage limits, and contractual endorsements into structured data.
        </p>
      </div>
    </div>
  </section>

  {/* Schema Explorer Grid */}
  <section class="spacing-section bg-surface border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-10 items-start">
        {categories.map((category) => {
          const Icon = category.icon;
          return (
            <div class="rounded-2xl border border-border bg-background p-6 sm:p-8 shadow-subtle flex flex-col justify-between h-full transition-all hover:border-border-hover">
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-9 h-9 rounded-xl bg-surface border border-border flex items-center justify-center text-foreground shrink-0 shadow-subtle">
                    <Icon class="w-4 h-4" />
                  </div>
                  <h2 class="text-h3 text-foreground text-lg">{category.title}</h2>
                </div>
                <p class="text-small text-muted-foreground mb-6 leading-relaxed">
                  {category.description}
                </p>

                <div class="divide-y divide-border border-t border-border">
                  {category.fields.map((field) => (
                    <div class="py-3.5 space-y-1">
                      <div class="text-xs font-semibold text-foreground tracking-tight">
                        {field.name}
                      </div>
                      <p class="text-small text-muted-foreground leading-normal">
                        {field.desc}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* Why Normalization Matters */}
  <section class="spacing-section bg-background border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-h2 text-foreground spacing-heading">Why Structured Normalization Matters</h2>
        <p class="text-body text-muted-foreground text-pretty">
          Raw certificate documents use inconsistent broker formats. Normalizing data turns messy files into actionable records.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-border bg-surface shadow-subtle space-y-2.5">
          <div class="w-8 h-8 rounded-lg bg-background border border-border flex items-center justify-center text-foreground shadow-subtle">
            <Calendar class="w-4 h-4" />
          </div>
          <h3 class="text-h3 text-foreground text-base">Consistent Expiration Dates</h3>
          <p class="text-small text-muted-foreground leading-relaxed">
            Different brokers write dates in various formats. CertifiTrack standardizes every date so your spreadsheets sort cleanly and renewal alerts fire reliably.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-surface shadow-subtle space-y-2.5">
          <div class="w-8 h-8 rounded-lg bg-background border border-border flex items-center justify-center text-foreground shadow-subtle">
            <DollarSign class="w-4 h-4" />
          </div>
          <h3 class="text-h3 text-foreground text-base">Structured Coverage Limits</h3>
          <p class="text-small text-muted-foreground leading-relaxed">
            Policy thresholds are parsed into clean numeric figures, making it effortless to filter contractors who meet project minimums versus those who are underinsured.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-surface shadow-subtle space-y-2.5">
          <div class="w-8 h-8 rounded-lg bg-background border border-border flex items-center justify-center text-foreground shadow-subtle">
            <FileText class="w-4 h-4" />
          </div>
          <h3 class="text-h3 text-foreground text-base">Traceable Extracted Data</h3>
          <p class="text-small text-muted-foreground leading-relaxed">
            Every extracted spreadsheet row retains its source certificate filename, ensuring total clarity during annual insurance audits and subcontractor reconciliations.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="spacing-section bg-surface text-center">
    <div class="container mx-auto px-4 max-w-xl">
      <h2 class="text-h2 text-foreground spacing-heading">Ready to extract your COI records?</h2>
      <p class="text-body-large spacing-paragraph text-muted-foreground">Upload your PDFs or ZIP folder to generate structured spreadsheets in seconds.</p>
      <Button href="/en/upload" size="lg" class="mt-2 shadow-elevated transition-transform hover:scale-105">
        Start Extracting Free
      </Button>
    </div>
  </section>
</Layout>
