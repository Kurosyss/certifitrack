---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';

const title = "Refund Policy | CertifiTrack";
const description = "Our refund policy and satisfaction guarantee.";
---

<Layout title={title} description={description}>
  <section class="py-16 sm:py-24 bg-background">
    <div class="reading-width px-4 sm:px-6">
      
      {/* Header */}
      <div class="mb-12">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground mb-3">Refund Policy</h1>
        <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest">Last Updated: August 2026</p>
      </div>

      {/* Intro */}
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <p class="text-base leading-relaxed text-muted-foreground mb-10">
          We want you to be completely satisfied with our cleanup service. Please review our policy for refunds and revisions.
        </p>

        {/* Contents Navigation */}
        <div class="bg-surface border border-border rounded-lg p-5 mb-12 shadow-subtle">
          <h2 class="text-xs font-semibold text-foreground uppercase tracking-widest mb-3">Contents</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#guarantee" class="text-muted-foreground hover:text-foreground transition-colors">1. Satisfaction Guarantee</a></li>
            <li><a href="#revisions" class="text-muted-foreground hover:text-foreground transition-colors">2. Revisions</a></li>
            <li><a href="#eligibility" class="text-muted-foreground hover:text-foreground transition-colors">3. Refund Eligibility</a></li>
            <li><a href="#contact" class="text-muted-foreground hover:text-foreground transition-colors">4. Contact Us</a></li>
          </ul>
        </div>

        {/* Content Sections */}
        <div class="space-y-12">
          
          <section id="guarantee" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">1. Satisfaction Guarantee</h2>
            <p class="text-base text-muted-foreground">
              If the tracker we deliver does not accurately reflect the documents you provided, we will fix it at no additional cost.
            </p>
          </section>

          <section id="revisions" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">2. Revisions</h2>
            <p class="text-base text-muted-foreground mb-4">
              If you spot an error in data extraction, you must notify us within [CONFIRM REVISION NOTIFICATION PERIOD, e.g., 14 days] of receiving your tracker. We will review the discrepancy against your original files and issue a corrected version within [CONFIRM REVISION TURNAROUND, e.g., 1 business day].
            </p>
            <p class="text-base text-muted-foreground">
              Note: Providing new or omitted documents after the initial cleanup is considered a new request and is not covered under revisions.
            </p>
          </section>

          <section id="eligibility" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">3. Refund Eligibility</h2>
            <p class="text-base text-muted-foreground mb-4">
              [CONFIRM REFUND POLICY: e.g., Because our service involves manual labor, refunds are generally not provided once work has commenced. However, if we fail to deliver your tracker within the promised timeframe, or if the delivered work is fundamentally unusable and we cannot correct it, we will issue a full refund to your original payment method.]
            </p>
          </section>

          <section id="contact" class="scroll-mt-24 pt-8 border-t border-border">
            <h2 class="text-xl font-semibold text-foreground mb-3">4. Contact Us</h2>
            <p class="text-base text-muted-foreground mb-4">
              To request a revision or discuss a refund, please contact our support team.
            </p>
            <a href={`mailto:${siteConfig.supportEmail}`} class="text-accent hover:underline font-medium">{siteConfig.supportEmail}</a>
          </section>

        </div>
      </div>

    </div>
  </section>
</Layout>
