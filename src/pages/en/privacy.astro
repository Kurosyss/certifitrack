---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';
import { ShieldCheck } from 'lucide-react';

const title = "Privacy Policy | CertifiTrack";
const description = "How we handle your data and documents.";
---

<Layout title={title} description={description}>
  <section class="py-16 sm:py-24 bg-background">
    <div class="reading-width px-4 sm:px-6">
      
      {/* Header */}
      <div class="mb-12">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground mb-3">Privacy Policy</h1>
        <p class="text-sm font-medium text-muted-foreground uppercase tracking-widest">Last Updated: August 2026</p>
      </div>

      {/* Intro */}
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <p class="text-base leading-relaxed text-muted-foreground mb-10">
          {siteConfig.legalEntityName} ("CertifiTrack") provides administrative data extraction services. We take the privacy and security of your documents seriously. This policy explains what we collect and how we use it.
        </p>

        {/* Contents Navigation */}
        <div class="bg-surface border border-border rounded-lg p-5 mb-12 shadow-subtle">
          <h2 class="text-xs font-semibold text-foreground uppercase tracking-widest mb-3">Contents</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#information-we-collect" class="text-muted-foreground hover:text-foreground transition-colors">1. Information We Collect</a></li>
            <li><a href="#how-we-use" class="text-muted-foreground hover:text-foreground transition-colors">2. How We Use Your Information</a></li>
            <li><a href="#retention" class="text-muted-foreground hover:text-foreground transition-colors">3. Data Retention and Deletion</a></li>
            <li><a href="#sharing" class="text-muted-foreground hover:text-foreground transition-colors">4. Third-Party Sharing</a></li>
            <li><a href="#contact" class="text-muted-foreground hover:text-foreground transition-colors">5. Contact Us</a></li>
          </ul>
        </div>

        {/* Content Sections */}
        <div class="space-y-12">
          
          <section id="information-we-collect" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">1. Information We Collect</h2>
            <p class="text-base text-muted-foreground mb-4">We collect the information you voluntarily provide to us when you upload files for our cleanup service. This includes:</p>
            <ul class="list-disc pl-5 space-y-2 text-base text-muted-foreground mb-6">
              <li><strong class="text-foreground">Contact information:</strong> Name and email address used for delivery.</li>
              <li><strong class="text-foreground">Subcontractor lists:</strong> Names, emails, and required limits you provide for matching.</li>
              <li><strong class="text-foreground">Insurance Documents:</strong> Certificates of Insurance (COIs), ACORD forms, and endorsements contained in your upload.</li>
            </ul>
            
            {/* Callout */}
            <div class="flex gap-3 p-4 rounded-lg bg-muted/50 border border-border">
              <ShieldCheck class="w-5 h-5 text-accent shrink-0 mt-0.5" />
              <p class="text-sm text-foreground m-0 leading-relaxed">
                As a local-first application, CertifiTrack does not process payments or store financial information on our servers.
              </p>
            </div>
          </section>

          <section id="how-we-use" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">2. How We Use Your Information</h2>
            <p class="text-base text-muted-foreground">
              We use the uploaded documents strictly for the purpose of providing the CertifiTrack Cleanup service. This includes organizing the files, reading the documents to extract relevant dates and limits, and generating your final tracker. {siteConfig.aiTrainingPolicy}
            </p>
          </section>

          <section id="retention" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">3. Data Retention and Deletion</h2>
            <p class="text-base text-muted-foreground">
              Uploaded files and generated trackers are retained for {siteConfig.dataRetention}. After this period, source documents and output files are permanently deleted from our active systems. You are responsible for downloading and securely storing your own copies.
            </p>
          </section>

          <section id="sharing" class="scroll-mt-24">
            <h2 class="text-xl font-semibold text-foreground mb-4">4. Third-Party Sharing</h2>
            <p class="text-base text-muted-foreground">
              We do not sell, rent, or trade your data to third parties. We only share information with trusted service providers necessary to operate our service (such as secure cloud file hosting environments and payment processing providers).
            </p>
          </section>

          <section id="contact" class="scroll-mt-24 pt-8 border-t border-border">
            <h2 class="text-xl font-semibold text-foreground mb-3">5. Contact Us</h2>
            <p class="text-base text-muted-foreground mb-4">
              If you have questions about this Privacy Policy, please contact our support team.
            </p>
            <a href={`mailto:${siteConfig.supportEmail}`} class="text-accent hover:underline font-medium">{siteConfig.supportEmail}</a>
          </section>

        </div>
      </div>

    </div>
  </section>
</Layout>
