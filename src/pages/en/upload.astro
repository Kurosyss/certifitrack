---
import Layout from '../../layouts/Layout.astro';
import Uploader from '../../components/Uploader.tsx';

const title = "Upload COI Documents | CertifiTrack";
const description = "Upload your Certificate of Insurance PDFs or ZIP archive to extract structured insurance data into an Excel spreadsheet.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="spacing-section bg-background min-h-[calc(100vh-4rem)]" data-certifitrack-build="current-dev-2026-08-25-v4">
    <Uploader client:load lang="en" />
  </section>
</Layout>
