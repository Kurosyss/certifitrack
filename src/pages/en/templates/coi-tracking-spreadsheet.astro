---
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/ui/Button.astro';
import { 
  Download, 
  FileSpreadsheet, 
  CheckCircle2, 
  AlertTriangle, 
  ArrowRight,
  ShieldCheck,
  Building2,
  Calendar,
  Layers
} from 'lucide-react';

const title = "Free Certificate of Insurance (COI) Tracking Spreadsheet Template | CertifiTrack";
const description = "Download our free Excel and Google Sheets COI tracking spreadsheet. Track ACORD 25 expiration dates, policy limits, and compliance status.";
---

<Layout title={title} description={description}>
  {/* Hero Section */}
  <section class="spacing-section border-b border-border bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        {/* Left: Headline & Download */}
        <div class="lg:col-span-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-caption text-muted-foreground mb-4 shadow-subtle">
            Free Spreadsheet Resource
          </div>
          <h1 class="text-h1 text-foreground spacing-heading text-balance">
            Certificate of Insurance (COI) Tracking Spreadsheet Template
          </h1>
          <p class="text-body-large spacing-paragraph">
            A standardized, pre-formatted Excel workbook designed for general contractors, builders, and property managers to track ACORD 25 policy dates and limits.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
            <Button 
              href="/CERTIFITRACK_TEMPLATE.xlsx" 
              size="lg" 
              class="shadow-elevated w-full sm:w-auto transition-transform hover:scale-105" 
              download
            >
              <Download class="w-4 h-4 mr-2" />
              Download .XLSX Template
            </Button>
          </div>
          <p class="text-small text-muted-foreground">Free download &bull; Pre-configured with validation formulas &bull; Compatible with Excel & Google Sheets</p>
        </div>

        {/* Right: Live Interactive-Style Preview Card */}
        <div class="lg:col-span-6 w-full min-w-0">
          <div class="bg-surface rounded-2xl border border-border shadow-elevated overflow-hidden min-w-0 max-w-full">
            <div class="bg-muted/40 px-3 sm:px-4 py-3 border-b border-border flex items-center justify-between gap-2 min-w-0">
              <div class="flex items-center gap-2 text-xs font-semibold text-foreground min-w-0">
                <FileSpreadsheet class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
                <span class="truncate">CERTIFITRACK_TEMPLATE.xlsx</span>
              </div>
              <span class="text-[10px] uppercase font-sans tracking-wider text-muted-foreground bg-background px-2 py-0.5 rounded-md border border-border shrink-0">
                Standard Schema
              </span>
            </div>
            <div class="overflow-x-auto min-w-0 max-w-full">
              <table class="w-full min-w-[480px] text-left text-[11px] font-sans whitespace-nowrap">
                <thead class="bg-muted/20 text-muted-foreground border-b border-border text-[10px] uppercase tracking-wider">
                  <tr>
                    <th class="px-3 py-2 font-medium border-r border-border">Named Insured</th>
                    <th class="px-3 py-2 font-medium border-r border-border">GL Exp.</th>
                    <th class="px-3 py-2 font-medium border-r border-border">WC Exp.</th>
                    <th class="px-3 py-2 font-medium border-r border-border">GL Limit</th>
                    <th class="px-3 py-2 font-medium">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border text-foreground bg-surface">
                  <tr class="hover:bg-muted/30 transition-colors">
                    <td class="px-3 py-2.5 font-medium border-r border-border">Atlas Ridge Mechanical</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] border-r border-border">2026-10-12</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] border-r border-border">2026-10-12</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] text-muted-foreground border-r border-border">$1,000,000</td>
                    <td class="px-3 py-2.5">
                      <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        CURRENT
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-muted/30 transition-colors">
                    <td class="px-3 py-2.5 font-medium border-r border-border">Cedar Point Roofing</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] text-rose-600 dark:text-rose-400 font-medium border-r border-border">2026-01-14</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] border-r border-border">2026-11-30</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] text-muted-foreground border-r border-border">$2,000,000</td>
                    <td class="px-3 py-2.5">
                      <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                        EXPIRED
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-muted/30 transition-colors">
                    <td class="px-3 py-2.5 font-medium border-r border-border">Northstar Electrical</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] text-muted-foreground border-r border-border">—</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] text-amber-600 dark:text-amber-400 font-medium border-r border-border">2026-09-01</td>
                    <td class="px-3 py-2.5 tabular-nums text-[11px] text-muted-foreground border-r border-border">$1,000,000</td>
                    <td class="px-3 py-2.5">
                      <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                        EXPIRING
                      </span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="px-3 sm:px-4 py-2.5 bg-muted/20 border-t border-border flex flex-col sm:flex-row justify-between sm:items-center gap-2 text-[10px] text-muted-foreground min-w-0">
              <span class="truncate">Automatic renewal date highlighting included</span>
              <a href="/CERTIFITRACK_TEMPLATE.xlsx" download class="font-medium text-foreground hover:underline shrink-0">Download XLSX &rarr;</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Included Column Structure */}
  <section class="spacing-section bg-surface border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-h2 text-foreground spacing-heading">What Columns Are Pre-Configured?</h2>
        <p class="text-body text-muted-foreground">The template is organized into clear functional groups matching the layout of standard insurance certificates.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-border bg-background shadow-subtle space-y-3">
          <div class="w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-foreground mb-2">
            <Building2 class="w-4 h-4" />
          </div>
          <h3 class="text-h3 text-foreground text-base">Trade & Entity Data</h3>
          <ul class="space-y-1.5 text-small text-muted-foreground">
            <li>&bull; Subcontractor Legal Name</li>
            <li>&bull; Trade / Scope of Work</li>
            <li>&bull; Active Jobsite / Project Name</li>
            <li>&bull; Certificate PDF Filename</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-background shadow-subtle space-y-3">
          <div class="w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-foreground mb-2">
            <Calendar class="w-4 h-4" />
          </div>
          <h3 class="text-h3 text-foreground text-base">Policy Expiration Dates</h3>
          <ul class="space-y-1.5 text-small text-muted-foreground">
            <li>&bull; General Liability Expiration</li>
            <li>&bull; Workers' Comp Expiration</li>
            <li>&bull; Commercial Auto Expiration</li>
            <li>&bull; Umbrella / Excess Expiration</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-background shadow-subtle space-y-3">
          <div class="w-8 h-8 rounded-lg bg-surface border border-border flex items-center justify-center text-foreground mb-2">
            <ShieldCheck class="w-4 h-4" />
          </div>
          <h3 class="text-h3 text-foreground text-base">Coverage & Compliance</h3>
          <ul class="space-y-1.5 text-small text-muted-foreground">
            <li>&bull; GL Each Occurrence Limit</li>
            <li>&bull; GL General Aggregate Limit</li>
            <li>&bull; Additional Insured Endorsement</li>
            <li>&bull; Waiver of Subrogation Status</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* When Spreadsheets Work vs When Manual Entry Breaks Down */}
  <section class="spacing-section bg-background border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-h2 text-foreground spacing-heading">Manual Spreadsheets vs. Automated Extraction</h2>
        <p class="text-body text-muted-foreground">Spreadsheets are the industry standard for insurance tracking, but manual data entry introduces operational friction.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-start">
        {/* When spreadsheets work */}
        <div class="p-6 sm:p-8 rounded-2xl border border-border bg-surface shadow-subtle">
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
            <CheckCircle2 class="w-4 h-4 text-status-active" />
            <span>When Spreadsheets Are Ideal</span>
          </div>
          <h3 class="text-h3 text-foreground mb-4">Complete Control & Universal Compatibility</h3>
          <ul class="space-y-3 text-small text-muted-foreground leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-foreground font-bold">&bull;</span>
              <span><strong>Zero Software Lock-in:</strong> Works across Microsoft Excel, Google Sheets, LibreOffice, and internal ERP systems.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-foreground font-bold">&bull;</span>
              <span><strong>Audit-Ready Formats:</strong> Insurance auditors and general contractor risk managers expect standard spreadsheet exports.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-foreground font-bold">&bull;</span>
              <span><strong>Custom Formulas:</strong> Add conditional formatting, renewal alerts, and contractor-specific compliance rules easily.</span>
            </li>
          </ul>
        </div>

        {/* Where manual tracking breaks down */}
        <div class="p-6 sm:p-8 rounded-2xl border border-border bg-surface shadow-subtle">
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
            <AlertTriangle class="w-4 h-4 text-[var(--color-status-review)]" />
            <span>Where Manual Entry Fails</span>
          </div>
          <h3 class="text-h3 text-foreground mb-4">The Bottleneck of Manual Transcription</h3>
          <ul class="space-y-3 text-small text-muted-foreground leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-foreground font-bold">&bull;</span>
              <span><strong>Time-Consuming:</strong> Squinting at 50+ scanned ACORD PDFs to retype 10-digit policy numbers and expiration dates takes hours.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-foreground font-bold">&bull;</span>
              <span><strong>Typo Risk:</strong> Inadvertently transposing a single date digit can introduce transcription discrepancies into tracking records.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-foreground font-bold">&bull;</span>
              <span><strong>Renewal Backlog:</strong> As subcontractors email renewed certificates, manual updates get postponed, leaving records out of date.</span>
            </li>
          </ul>
        </div>
      </div>

      {/* Bridge to CertifiTrack */}
      <div class="mt-12 p-6 sm:p-8 rounded-2xl border border-border bg-muted/30 text-center max-w-3xl mx-auto">
        <h3 class="text-h3 text-foreground mb-2">Automate the Population of Your Spreadsheet</h3>
        <p class="text-small text-muted-foreground mb-6 max-w-xl mx-auto">
          Instead of manually retyping dates and limits into rows, drop your PDF certificates into CertifiTrack. We extract supported fields and export directly into this structured spreadsheet format.
        </p>
        <Button href="/en/upload" size="lg" class="shadow-elevated">
          Extract Your COI Documents
        </Button>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="spacing-section bg-surface text-center">
    <div class="container mx-auto px-4 max-w-xl">
      <h2 class="text-h2 text-foreground spacing-heading">Ready to clean up your tracking process?</h2>
      <p class="text-body-large spacing-paragraph">Download the template or let CertifiTrack populate it automatically.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/CERTIFITRACK_TEMPLATE.xlsx" variant="outline" size="lg" download>
          Download Template
        </Button>
        <Button href="/en/upload" size="lg" class="shadow-elevated">
          Extract COIs Automatically
        </Button>
      </div>
    </div>
  </section>
</Layout>
