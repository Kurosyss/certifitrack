---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';

const title = "Política de Privacidad | CertifiTrack";
const description = "Política de privacidad de CertifiTrack.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="spacing-section border-b border-border bg-background min-h-[60vh] flex items-center justify-center">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl text-center">
      <div class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 border border-amber-500/20 mb-6 shadow-subtle">PENDIENTE DE REVISIÓN LEGAL</div>
      <h1 class="text-h1 text-foreground spacing-heading">Política de Privacidad</h1>
      <p class="text-body-large spacing-paragraph">Nuestra Política de Privacidad en español se encuentra actualmente en revisión legal para garantizar su total exactitud.</p>
      <p class="text-body spacing-paragraph">Mientras tanto, por favor consulta la versión oficial en inglés.</p>
      
      <div class="spacing-cta mt-8">
        <Button href="/en/privacy" size="lg" class="shadow-sm">
          Ver Política en Inglés
        </Button>
      </div>
    </div>
  </section>
</Layout>
