---
import Layout from '../../layouts/Layout.astro';
import Uploader from '../../components/Uploader.tsx';

const title = "Subir Certificados COI | CertifiTrack";
const description = "Sube tus archivos PDF o archivo ZIP de certificados de seguro para extraer datos estructurados en una hoja de cálculo Excel.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="spacing-section bg-background min-h-[calc(100vh-4rem)]" data-certifitrack-build="current-dev-2026-08-25-v4">
    <Uploader client:load lang="es" />
  </section>
</Layout>
