---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';

const title = "Preguntas Frecuentes | Extracción de COI CertifiTrack";
const description = "Preguntas frecuentes sobre la extracción de Certificados de Seguro (COI) y seguimiento en Excel con CertifiTrack.";

const faqs = [
  {
    category: "Extracción y Flujo de Trabajo",
    questions: [
      {
        q: "¿Qué es un Certificado de Seguro ACORD 25 (COI)?",
        a: "Un ACORD 25 es el formulario estándar de Certificado de Seguro de Responsabilidad Civil utilizado en seguros comerciales. Resume tipos de cobertura clave, números de póliza, fechas de vigencia, fechas de vencimiento y límites para Responsabilidad Civil General, Automóvil, Exceso/Umbrella y Compensación de Trabajadores."
      },
      {
        q: "¿Cómo extrae CertifiTrack los datos de los PDFs de COI?",
        a: "CertifiTrack procesa sus documentos PDF ACORD 25 mediante un flujo especializado de segmentación y extracción. Aísla las secciones de cobertura, extrae números de póliza, límites y fechas de vencimiento, y los verifica mediante reglas de validación deterministas antes de generar un libro de Excel estructurado."
      },
      {
        q: "¿Puedo procesar múltiples certificados a la vez?",
        a: "Sí. Puede subir un solo archivo .pdf o comprimir múltiples certificados PDF en un archivo .zip. CertifiTrack extrae cada documento de forma segura, valida los campos y genera una hoja de cálculo Excel consolidada con una fila por certificado."
      },
      {
        q: "¿Cuánto tarda el proceso de extracción?",
        a: "La extracción automatizada normalmente procesa cada documento en 10 a 30 segundos, generando y descargando su archivo Excel (.xlsx) listo para usar inmediatamente al finalizar."
      }
    ]
  },
  {
    category: "Coberturas y Validación",
    questions: [
      {
        q: "¿Qué campos de cobertura de seguro se extraen?",
        a: "CertifiTrack extrae el Asegurado Nombrado (Subcontratista/Proveedor), Responsabilidad Civil General (Límites por ocurrencia y agregado, fechas de vigencia y vencimiento, nº de póliza), Automóvil Comercial (Límite único combinado, fechas, nº de póliza), Exceso/Umbrella (Límites, fechas, nº de póliza) y Compensación de Trabajadores (Límites estatutarios, fechas, nº de póliza)."
      },
      {
        q: "¿Es CertifiTrack un servicio de asesoría legal o cumplimiento?",
        a: "No. CertifiTrack es una herramienta de extracción de datos administrativos. Extrae y estructura la información impresa en sus certificados en una hoja de cálculo conveniente. No proporciona asesoramiento legal, verificación de endosos de pólizas ni evaluaciones de suscripción de seguros."
      },
      {
        q: "¿Cómo se validan las fechas de vencimiento y los límites?",
        a: "Los campos extraídos se evalúan mediante reglas deterministas que comprueban el formato de fecha (ISO-8601), aseguran que las fechas de vigencia sean anteriores a las de vencimiento, señalan períodos con conflicto o duración cero y verifican que los límites de póliza estén dentro de rangos numéricos válidos."
      }
    ]
  },
  {
    category: "Privacidad y Seguridad",
    questions: [
      {
        q: "¿Se almacenan mis certificados subidos de forma permanente?",
        a: "No. CertifiTrack opera de forma sin estado (stateless). Los archivos subidos se procesan en almacenamiento temporal aislado y se eliminan inmediatamente después de generar el archivo Excel. No mantenemos una base de datos permanente de sus documentos."
      },
      {
        q: "¿Se exponen las claves de API en el navegador?",
        a: "No. Todas las credenciales de proveedores de IA y el procesamiento de extracción se ejecutan estrictamente en el servidor backend. Las claves de API nunca se envían ni son accesibles desde el código JavaScript del cliente."
      }
    ]
  }
];

const allFaqItems = faqs.flatMap(g => g.questions);
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  
  <section class="spacing-section bg-background border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
      <div class="text-center mb-16">
        <h1 class="text-h1 text-foreground spacing-heading">Preguntas Frecuentes</h1>
        <p class="text-body-large spacing-paragraph">Todo lo que necesitas saber sobre la extracción de datos de COI y el seguimiento en hojas de cálculo.</p>
      </div>

      <div class="space-y-12">
        {faqs.map(group => (
          <div>
            <h2 class="text-h3 text-foreground mb-6 pb-2 border-b border-border font-semibold">{group.category}</h2>
            <div class="space-y-4">
              {group.questions.map(faq => (
                <details class="group bg-surface border border-border rounded-xl overflow-hidden shadow-subtle [&_summary::-webkit-details-marker]:hidden">
                  <summary class="flex items-center justify-between cursor-pointer p-6 font-medium text-foreground hover:bg-muted/30 transition-colors">
                    <span>{faq.q}</span>
                    <span class="ml-6 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="px-6 pb-6 pt-2 text-muted-foreground leading-relaxed">
                    <p class="text-small">{faq.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 text-center pt-8 border-t border-border">
        <h3 class="text-h3 text-foreground mb-2">¿Listo para procesar sus archivos COI?</h3>
        <p class="text-small text-muted-foreground mb-6">Suba su carpeta de certificados y genere un registro en Excel en segundos.</p>
        <Button href="/es/upload" size="lg">Subir Carpeta de COI</Button>
      </div>
    </div>
  </section>
</Layout>
