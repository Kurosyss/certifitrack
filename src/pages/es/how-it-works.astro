---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { UploadCloud, CheckCircle2, FileSpreadsheet } from 'lucide-react';

const title = "Cómo Funciona | CertifiTrack";
const description = "Aprende cómo funciona nuestro proceso único de auditoría de COI.";
---

<Layout title={title} description={description}>
  <section class="spacing-section border-b border-border bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-h1 text-foreground spacing-heading">Cómo Funciona</h1>
        <p class="text-body-large text-balance">Tres simples pasos para un registro limpio.</p>
      </div>
      
      <div class="grid md:grid-cols-3 spacing-content relative max-w-5xl mx-auto">
        {/* Connecting Line */}
        <div class="hidden md:block absolute top-[1.25rem] left-[16%] right-[16%] h-px bg-border -z-10"></div>
        
        {/* Step 1 */}
        <div class="flex flex-col gap-6 relative">
          <div class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-foreground font-medium text-sm mx-auto z-10">1</div>
          <div class="text-center">
            <h2 class="text-h2 text-foreground mb-2">Envíanos tus archivos</h2>
            <p class="text-body text-balance">Sube tu hoja de cálculo actual de subcontratistas y una carpeta con tus PDFs de COI.</p>
          </div>
          <div class="bg-surface rounded-xl border border-border shadow-subtle p-6 mt-auto">
            <div class="border border-dashed border-border/80 bg-background rounded-lg p-6 flex flex-col items-center justify-center text-center gap-3">
              <UploadCloud class="w-6 h-6 text-muted-foreground" />
              <span class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">Suelta la carpeta aquí</span>
            </div>
          </div>
        </div>
        
        {/* Step 2 */}
        <div class="flex flex-col gap-6 relative">
          <div class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-foreground font-medium text-sm mx-auto z-10">2</div>
          <div class="text-center">
            <h2 class="text-h2 text-foreground mb-2">Nosotros los organizamos</h2>
            <p class="text-body text-balance">Emparejamos documentos, extraemos fechas y marcamos los elementos que necesitan tu revisión.</p>
          </div>
          <div class="bg-surface rounded-xl border border-border shadow-subtle p-6 mt-auto">
            <div class="flex flex-col gap-3">
              <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-[0.1em] mb-1">Procesando</div>
              <div class="w-full h-1.5 bg-border rounded-full overflow-hidden">
                <div class="w-[75%] h-full bg-foreground"></div>
              </div>
              <div class="flex items-center justify-between text-xs font-medium">
                <span class="text-muted-foreground">Extrayendo límites...</span>
                <span class="text-foreground">75%</span>
              </div>
            </div>
          </div>
        </div>
        
        {/* Step 3 */}
        <div class="flex flex-col gap-6 relative">
          <div class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-foreground font-medium text-sm mx-auto z-10">3</div>
          <div class="text-center">
            <h2 class="text-h2 text-foreground mb-2">Obtén tu informe</h2>
            <p class="text-body text-balance">En menos de 24 horas, recibe un registro limpio que destaca exactamente a quién debes llamar.</p>
          </div>
          <div class="bg-surface rounded-xl border border-border shadow-subtle p-6 mt-auto">
            <div class="space-y-3">
              <div class="flex items-center justify-between p-3 rounded-lg bg-background border border-border/50">
                <div class="flex items-center gap-2">
                  <FileSpreadsheet class="w-4 h-4 text-muted-foreground"/>
                  <span class="text-xs font-medium text-foreground">Registro_Final.xlsx</span>
                </div>
                <CheckCircle2 class="w-4 h-4 text-muted-foreground" />
              </div>
              <div class="text-[10px] text-muted-foreground uppercase tracking-widest text-center">Listo para descargar</div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </section>

  <section class="spacing-section bg-surface">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl text-center">
      <h2 class="text-h2 text-foreground spacing-heading">¿Listo para organizarte?</h2>
      <Button href="/es/pricing" size="lg" class="mt-4 shadow-elevated">
        Ver Precios
      </Button>
    </div>
  </section>
</Layout>
