---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { UploadCloud, CheckCircle2, FileSpreadsheet } from 'lucide-react';

const title = "Cómo Funciona | CertifiTrack";
const description = "Aprende cómo CertifiTrack extrae y valida certificados de seguros ACORD 25 en libros de Excel estructurados.";
---

<Layout title={title} description={description}>
  <section class="spacing-section border-b border-border bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-caption text-muted-foreground mb-4 shadow-subtle">
          Flujo de Trabajo en 3 Pasos
        </div>
        <h1 class="text-h1 text-foreground spacing-heading text-balance">Cómo Funciona CertifiTrack</h1>
        <p class="text-body-large text-muted-foreground text-pretty">
          De carpetas desordenadas de PDFs a registros de seguro estructurados y listos para auditorías en segundos.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 relative max-w-5xl mx-auto">
        {/* Paso 1 */}
        <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface p-6 shadow-subtle relative">
          <div class="w-8 h-8 rounded-full bg-background border border-border flex items-center justify-center text-foreground font-semibold text-xs shrink-0 shadow-subtle">
            01
          </div>
          <div>
            <h2 class="text-h3 text-foreground mb-2">Sube tus Documentos</h2>
            <p class="text-small text-muted-foreground leading-relaxed">
              Arrastra certificados PDF ACORD 25 individuales o un archivo comprimido .ZIP con múltiples documentos.
            </p>
          </div>
          <div class="border border-dashed border-border bg-background rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 mt-auto">
            <UploadCloud class="w-5 h-5 text-muted-foreground" />
            <span class="text-[11px] font-sans tabular-nums text-muted-foreground">.pdf o .zip hasta 10MB</span>
          </div>
        </div>
        
        {/* Paso 2 */}
        <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface p-6 shadow-subtle relative">
          <div class="w-8 h-8 rounded-full bg-background border border-border flex items-center justify-center text-foreground font-semibold text-xs shrink-0 shadow-subtle">
            02
          </div>
          <div>
            <h2 class="text-h3 text-foreground mb-2">Extrae y Normaliza</h2>
            <p class="text-small text-muted-foreground leading-relaxed">
              El motor aísla las tablas de cobertura, estandariza números de póliza, normaliza fechas y estructura límites.
            </p>
          </div>
          <div class="bg-background rounded-xl border border-border p-4 mt-auto space-y-2.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">Resp. Civil General</span>
              <span class="tabular-nums font-medium text-foreground">$1,000,000 / $2,000,000</span>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">Workers' Comp</span>
              <span class="font-medium text-foreground">Estatutario</span>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">Fechas Consistentes</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-medium tabular-nums">2026-01-15 &rarr; 2027-01-15</span>
            </div>
          </div>
        </div>
        
        {/* Paso 3 */}
        <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface p-6 shadow-subtle relative">
          <div class="w-8 h-8 rounded-full bg-background border border-border flex items-center justify-center text-foreground font-semibold text-xs shrink-0 shadow-subtle">
            03
          </div>
          <div>
            <h2 class="text-h3 text-foreground mb-2">Descarga tu Libro de Excel</h2>
            <p class="text-small text-muted-foreground leading-relaxed">
              Recibe al instante un archivo Excel (.xlsx) estructurado que destaca pólizas vigentes, por vencer, vencidas o en revisión.
            </p>
          </div>
          <div class="bg-background rounded-xl border border-border p-4 mt-auto flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-semibold text-foreground">
              <FileSpreadsheet class="w-4 h-4 text-status-active" />
              <span>COI_Tracker_Export.xlsx</span>
            </div>
            <CheckCircle2 class="w-4 h-4 text-status-active" />
          </div>
        </div>
      </div>
      
    </div>
  </section>

  {/* CTA */}
  <section class="spacing-section bg-surface text-center">
    <div class="container mx-auto px-4 max-w-xl">
      <h2 class="text-h2 text-foreground spacing-heading">¿Listo para procesar tus certificados?</h2>
      <p class="text-body-large spacing-paragraph">Sube tus archivos para generar un registro de seguros listo para auditorías.</p>
      <Button href="/es/upload" size="lg" class="shadow-elevated transition-transform hover:scale-105">
        Comienza a Extraer Gratis
      </Button>
    </div>
  </section>
</Layout>
