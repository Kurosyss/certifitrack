---
import { siteConfig } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { ArrowRight, CheckCircle2, FileSpreadsheet, Lock } from 'lucide-react';

const title = "Precios | CertifiTrack";
const description = "Precios simples. Limpieza única. Sin suscripciones ni configuración de software.";
---

<Layout title={title} description={description}>
  <section class="spacing-section border-b border-border bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-h1 text-foreground spacing-heading text-balance">Precios simples. Limpieza única.</h1>
        <p class="text-body-large spacing-paragraph">Sin suscripción mensual. Sin configuración de software. Sin portal para tu equipo. Tú envías los archivos. Nosotros los organizamos.</p>
      </div>
      
      {/* $49 Tier - HERO PRIMARY */}
      <div class="bg-surface rounded-3xl border border-border shadow-elevated overflow-hidden mb-12">
        <div class="p-8 sm:p-12">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 mb-12 border-b border-border/50 pb-12">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1 text-[11px] font-medium tracking-wide uppercase text-muted-foreground mb-4">
                <span class="flex h-1.5 w-1.5 rounded-full bg-status-active"></span>
                Servicio Estándar
              </div>
              <h2 class="text-display text-foreground">Limpia mi Carpeta de COI</h2>
              <p class="text-body text-muted-foreground mt-2">Hasta 25 subcontratistas.</p>
            </div>
            
            <div class="flex flex-col md:items-end">
              <div class="flex items-baseline gap-2">
                <span class="text-5xl lg:text-6xl font-medium tracking-tight text-foreground">$49</span>
                <span class="text-sm font-medium uppercase tracking-widest text-muted-foreground">pago único</span>
              </div>
              <p class="text-xs text-muted-foreground mt-2 flex items-center gap-1.5"><Lock class="w-3.5 h-3.5"/> Pago Seguro (Stripe)</p>
            </div>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8 mb-12">
            <div class="flex flex-col gap-2">
              <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">Lo que nos envías</span>
              <p class="text-sm font-medium text-foreground">Una carpeta ZIP desorganizada con tus PDFs de COI y tu lista de subcontratistas.</p>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">Lo que te devolvemos</span>
              <p class="text-sm font-medium text-foreground">Un registro estructurado en Excel resaltando los documentos faltantes y vencidos.</p>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">Entrega</span>
              <p class="text-sm font-medium text-foreground">Completado y enviado a tu bandeja de entrada en 24–48 horas.</p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 items-center justify-between bg-background p-6 rounded-2xl border border-border">
            <div class="flex items-center gap-3">
              <FileSpreadsheet class="w-8 h-8 text-status-active"/>
              <div>
                <div class="text-sm font-medium text-foreground">¿Listo para empezar?</div>
                <div class="text-xs text-muted-foreground">Sube tus archivos en la siguiente pantalla.</div>
              </div>
            </div>
            <Button href={siteConfig.stripePaymentLink25} size="lg" class="w-full sm:w-auto shadow-elevated transition-transform hover:scale-105">
              Iniciar Proceso de Limpieza — $49
            </Button>
          </div>
        </div>
      </div>

      {/* $99 Tier & Custom - SECONDARY (Side by side at bottom) */}
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-background rounded-2xl border border-border p-8 text-center flex flex-col justify-center">
          <h3 class="text-h3 text-foreground mb-1">¿Más de 25 subcontratistas?</h3>
          <p class="text-small mb-6">Nuestro nivel Pro maneja hasta 100 subcontratistas por una tarifa fija de $99. Misma entrega en 24h.</p>
          <div class="mt-auto">
            <Button href={siteConfig.stripePaymentLink100} variant="outline" class="w-full bg-surface">
              Seleccionar Nivel Pro &mdash; $99
            </Button>
          </div>
        </div>

        <div class="bg-background rounded-2xl border border-border p-8 text-center flex flex-col justify-center">
          <h3 class="text-h3 text-foreground mb-1">¿Necesitas cumplimiento corporativo?</h3>
          <p class="text-small mb-6">¿Más de 100 subcontratistas o necesitas monitoreo continuo de COIs durante el año?</p>
          <div class="mt-auto">
            <Button href="/es/contact" variant="outline" class="w-full bg-surface">
              Contactar a Ventas
            </Button>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
