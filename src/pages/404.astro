---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';

const title = "Page Not Found | CertifiTrack";
const description = "The page you're looking for doesn't exist or may have moved.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="flex flex-col items-center justify-center min-h-[80vh] py-24 text-center px-4 bg-background">
    <div class="max-w-md mx-auto space-y-6">
      
      <div class="bg-surface border border-border rounded-xl p-8 shadow-sm text-center">
        <div class="text-[10px] font-medium text-muted-foreground uppercase tracking-[0.2em] mb-4">Error 404</div>
        <h1 class="text-4xl font-semibold tracking-tight text-foreground mb-4">CERTIFICATE MISSING</h1>
        <p class="text-body spacing-paragraph">Looks like this page never made it into the folder.</p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <Button href="/en/" size="lg" class="w-full sm:w-auto shadow-elevated">
            Back to CertifiTrack
          </Button>
          <Button href="/en/pricing" variant="outline" size="lg" class="w-full sm:w-auto hover:bg-muted/50">
            View Pricing
          </Button>
        </div>
      </div>
      
    </div>
  </section>
</Layout>
