---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';

const title = "Page Not Found | CertifiTrack";
const description = "The page you are looking for does not exist or may have moved.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="flex flex-col items-center justify-center min-h-[80vh] py-24 text-center px-4 bg-background">
    <div class="max-w-md mx-auto space-y-6">
      
      <div class="bg-surface border border-border rounded-2xl p-8 sm:p-10 shadow-elevated text-center">
        <div class="inline-flex items-center px-2.5 py-1 rounded-full text-caption bg-muted text-muted-foreground mb-4">Error 404</div>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground mb-3">Document Not Found</h1>
        <p class="text-small text-muted-foreground mb-8 leading-relaxed">The page or resource you requested could not be located.</p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="/en/" size="lg" class="w-full sm:w-auto shadow-subtle">
            Back to Home
          </Button>
          <Button href="/en/upload" variant="outline" size="lg" class="w-full sm:w-auto">
            Upload Documents
          </Button>
        </div>
      </div>
      
    </div>
  </section>
</Layout>
