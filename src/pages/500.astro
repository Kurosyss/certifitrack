---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import { AlertCircle } from 'lucide-react';

const title = "500 - Processing Error | CertifiTrack";
const description = "Something went wrong during document processing.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="min-h-[70vh] flex items-center justify-center py-24 bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-lg text-center">
      <div class="p-8 sm:p-10 rounded-2xl border border-border bg-surface shadow-elevated">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-status-expired-bg)] border border-[var(--color-status-expired-border)] text-[var(--color-status-expired)] mb-4">
          <AlertCircle class="w-6 h-6" />
        </div>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground mb-3">Something Went Wrong</h1>
        <p class="text-small text-muted-foreground mb-8 leading-relaxed">
          An unexpected error occurred during processing. Please try your request again or return to the homepage.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="/en/" size="lg" class="w-full sm:w-auto shadow-subtle">
            Back to Home
          </Button>
          <Button href="/en/contact" variant="outline" size="lg" class="w-full sm:w-auto">
            Contact Support
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
